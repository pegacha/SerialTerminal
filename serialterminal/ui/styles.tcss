/* Compact layout: every control is one row tall so the log gets the screen. */

#title {
    height: 1;
    width: 100%;
    content-align: center middle;
    text-style: bold;
    color: $accent;
    background: $panel;
}

/* ---- Serial Config ------------------------------------------------------ */

/* Top padding keeps a section's title off its first row of controls. */
#serial-bar {
    height: auto;
    padding: 1 1 0 1;
    border: round $primary;
    border-title-align: left;
    border-title-color: $text;
    border-title-background: $panel;
    border-title-style: bold;
}

#serial-row-top, #serial-row-bottom {
    height: 1;
}

#serial-row-top {
    margin-bottom: 1;
}

#serial-bar Select {
    margin-right: 1;
}

/* Fixed, not 1fr: stretched across the row it made a 70-column dropdown. */
#serial-port-select {
    width: 36;
}

/* One line per port. Wrapped, each "Standard Serial over Bluetooth link"
   took two lines and six ports filled eleven. */
#serial-port-select SelectOverlay {
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#serial-baud {
    width: 12;
}

#serial-parity {
    width: 13;
}

#serial-bits {
    width: 11;
}

#serial-stop-bits {
    width: 13;
}

.serial-button {
    width: auto;
    min-width: 10;
    margin-right: 1;
}

#serial-status {
    width: auto;
    padding: 0 1;
    text-style: bold;
}

.status-connected {
    color: $success;
}

.status-disconnected {
    color: $error;
}

/* ---- Log ---------------------------------------------------------------- */

#log-tabs {
    height: 1fr;
}

/* Log defaults to overflow-x: scroll, which keeps an empty horizontal
   scrollbar - a whole dead row - under every tab. auto still scrolls a frame
   wider than the log, but gives the row back otherwise. */
LogPanel {
    overflow-x: auto;
}

/* Attached to the log it filters: a blank row above made the box look
   like stray text once its placeholder was gone. */
#log-filter {
    margin-top: 0;
    background: $boost;
}

#log-status {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $warning;
    text-style: bold;
}

/* ---- Send Command ------------------------------------------------------- */

#quick-send-window {
    height: auto;
    padding: 1 1 0 1;
    border: round $primary;
    border-title-align: left;
    border-title-color: $text;
    border-title-background: $panel;
    border-title-style: bold;
    border-subtitle-color: $error;
    border-subtitle-align: left;
}

#quick-send-horizontal {
    height: 1;
}

.quick-send-button {
    width: auto;
    min-width: 8;
    margin-right: 1;
}

#send-format-select {
    width: 12;
    margin-right: 1;
}

#send-line-ending {
    width: 11;
    margin-right: 1;
}

#send-checksum {
    width: 18;
    margin-right: 1;
}

#quick-send-input {
    width: 1fr;
}

/* ---- Workspace: log + send on the left, buttons beside them ------------- */

#main-row {
    height: 1fr;
}

#workspace {
    width: 1fr;
    height: 1fr;
}

/* ---- Collapsible side panels ---------------------------------------------
   Recent projects (left, F3, collapsed by default) and the control buttons
   (right, F4, open by default). Collapsed, a panel leaves a strip with its
   name written downwards - or across one row where the buttons sit under
   the log in a narrow window. */
.side-strip {
    width: 3;
    height: 1fr;
    border: round $primary 60%;
    background: transparent;
    pointer: pointer;
}

.side-strip:hover {
    border: round $primary;
    background: $boost;
}

.strip-arrow {
    width: 1fr;
    color: $text-accent;
    text-style: bold;
}

.strip-vertical {
    width: 1fr;
    color: $text-muted;
    text-style: bold;
}

.strip-horizontal {
    display: none;
    color: $text-muted;
    text-style: bold;
}

.-narrow #buttons-strip {
    width: 1fr;
    height: 3;
}

.-narrow #buttons-strip .strip-arrow,
.-narrow #buttons-strip .strip-vertical {
    display: none;
}

.-narrow #buttons-strip .strip-horizontal {
    display: block;
}

#buttons-strip {
    display: none;
}

#hide-buttons {
    width: 3;
    min-width: 3;
    margin-right: 0;
}

#recent-files {
    width: auto;
    height: 1fr;
}

#recent-body {
    display: none;
    width: 32;
    height: 1fr;
    padding: 0 1;
    border: round $primary;
}

#recent-files.-expanded #recent-strip {
    display: none;
}

#recent-files.-expanded #recent-body {
    display: block;
}

#recent-header {
    height: 1;
}

#recent-title {
    width: 1fr;
    text-style: bold;
}

#recent-toggle {
    width: 3;
    min-width: 3;
}

#recent-list {
    height: auto;
    max-height: 1fr;
    margin-top: 1;
    background: transparent;
}

#recent-empty {
    margin-top: 1;
    color: $text-muted;
}

#log-column {
    width: 1fr;
    height: 1fr;
}

#multi-format-log {
    height: 1fr;
}

/* ---- Control Buttons ---------------------------------------------------- */

/* A full-height sidebar, so buttons never take rows from the log. 34 columns
   hold one column of buttons with labels up to ~25 characters; longer ones
   are ellipsised with the full text on hover. Scrolls when there are more
   buttons than rows. */
#control-buttons {
    width: 34;
    height: 1fr;
    overflow-y: auto;
    scrollbar-size-vertical: 1;
    padding: 1 1 0 1;
    border: round $primary;
    border-title-align: left;
    border-title-color: $text;
    border-title-background: $panel;
    border-title-style: bold;
}

/* Under 100 columns a sidebar would leave the log too narrow for a hex
   frame, so the buttons stack under the log instead - capped and scrollable,
   or a big button set (e.g. a Docklight import) left the log no rows. */
.-narrow #workspace {
    layout: vertical;
}

.-narrow #control-buttons {
    width: 1fr;
    height: auto;
    max-height: 35%;
}

.-narrow.-short #control-buttons {
    max-height: 25%;
}

/* ---- Short terminals (< 30 rows): spacing gives way to log rows --------- */

.-short #title {
    display: none;
}

.-short #serial-row-top {
    margin-bottom: 0;
}

.-short #serial-bar,
.-short #quick-send-window,
.-short #control-buttons {
    padding-top: 0;
}

/* The vertical gap matters: without it stacked one-row buttons read as a
   single multi-line button, and it is unclear what a click will hit. */
#buttons-container {
    grid-gutter: 1 1;
}

/* nowrap is what makes the ellipsis work: without it a long label wrapped,
   and a one-row compact button just cut it off mid-word with no "...". */
.control-button {
    width: 1fr;
    background: $primary-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.control-button:hover {
    background: $primary;
}

.control-button.button-repeating {
    background: $accent;
    color: $text;
    text-style: bold;
}

/* File dialogs' bottom bar. The library splits the width 2:1 between the
   file name and the filter after the buttons take 16 columns each, which
   left the filter 15 wide and its label wrapping onto two rows. */
FileSystemPickerScreen InputBar {
    padding: 1 1 0 1;
}

FileSystemPickerScreen InputBar Input {
    width: 1fr;
}

FileSystemPickerScreen InputBar Select {
    width: 24;
}

FileSystemPickerScreen InputBar Button {
    width: auto;
    min-width: 10;
}

#no-buttons-msg {
    padding: 0 1;
    color: $text-muted;
}

/* ---- Control button toolbar ---------------------------------------------- */

#buttons-toolbar {
    height: 1;
    margin-bottom: 1;
}

.toolbar-spacer {
    width: 1fr;
}

.toolbar-button {
    width: auto;
    min-width: 8;
    margin-right: 1;
}

/* Edit mode: a click opens the editor instead of sending, so make it
   unmistakable that the buttons are not live. */
#control-buttons.-editing {
    border: round $warning;
}

#control-buttons.-editing .control-button {
    background: $warning-muted;
}

/* ---- Button editor (Docklight-style sequence definition) ----------------- */

ButtonEditor {
    align: center middle;
    background: $background 60%;
}

#editor {
    width: 100;
    max-width: 100%;
    height: 34;
    max-height: 100%;
    padding: 0 1;
    border: round $primary;
    border-title-align: left;
    border-title-style: bold;
    background: $surface;
}

/* Scrolls on short terminals; the OK / Cancel row stays put below it. */
#editor-body {
    height: 1fr;
}

.ed-row {
    height: auto;
    margin-top: 1;
}

.ed-label {
    width: 16;
    text-style: bold;
}

.ed-sublabel {
    width: auto;
    margin-right: 1;
    color: $text-muted;
}

#ed-name {
    width: 1fr;
}

#ed-mode {
    layout: horizontal;
    width: auto;
    height: auto;
    border: none;
    padding: 0;
    background: transparent;
}

#ed-mode RadioButton {
    width: auto;
    margin-right: 1;
    background: transparent;
}

#ed-pos {
    width: 1fr;
    content-align: right middle;
    color: $text-muted;
}

#ed-sequence {
    height: 6;
}

#ed-error {
    height: auto;
    min-height: 1;
    color: $error;
}

.ed-rule {
    margin: 0;
}

.ed-settings {
    height: auto;
}

#ed-tabs {
    width: 1fr;
    height: auto;
}

#ed-tabs TabPane {
    height: auto;
    padding: 1 1 0 1;
}

.ed-inline {
    height: auto;
    margin-top: 1;
}

.ed-inline Label {
    width: auto;
    margin-right: 1;
}

#ed-repeat-seconds, #ed-auto-delay {
    width: 8;
    margin-right: 1;
}

#ed-auto-format {
    width: 12;
    margin-right: 1;
}

#ed-auto-data {
    width: 1fr;
}

#ed-checksum, #ed-eol {
    width: 24;
}

.ed-note {
    margin-top: 1;
    color: $text-muted;
}

.ed-doc-label {
    margin-top: 1;
    text-style: bold;
}

#ed-doc {
    height: 4;
}

#ed-buttons {
    height: 1;
    margin-top: 1;
}

#ed-buttons Button {
    width: auto;
    min-width: 10;
    margin-left: 1;
}

.ed-spacer {
    width: 1fr;
}

/* Checkboxes: Textual's default is a tall bordered box that also truncates
   its label - here they sit inline like the rest of the form. */
#editor Checkbox {
    border: none;
    padding: 0;
    background: transparent;
}

/* The radio set highlights its keyboard cursor even when unfocused, which
   made the first mode (ASCII) look selected whatever the real mode was. Only
   show the cursor while the set has focus; the dot shows the mode. */
#ed-mode:blur > RadioButton.-selected > .toggle--label {
    background: transparent;
}

.ed-note-tight {
    margin-top: 0;
}

/* Under 30 rows the stacked button panel is only a couple of rows tall; the
   gap under the toolbar pushed every button out of view. */
.-short #buttons-toolbar {
    margin-bottom: 0;
}

/* File dialogs: Recent files / Favorites row above the file list. */
#picker-places {
    height: 1;
    margin: 1 1 1 1;
}

#picker-places Select {
    width: 1fr;
    margin-right: 1;
}

#picker-places Button {
    width: auto;
    min-width: 10;
    margin-right: 1;
}

/* Selected text was invisible: themes leave $screen-selection-foreground
   transparent, which most widgets read as "keep the text's colour" but Log
   (the message tabs) draws literally - in a colour you can't see. */
Screen > .screen--selection {
    color: $foreground;
}

/* ---- Settings (F2) ------------------------------------------------------- */

SettingsScreen {
    align: center middle;
    background: $background 60%;
}

#settings {
    width: 76;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    padding: 0 2;
    border: round $primary;
    border-title-align: left;
    border-title-style: bold;
    background: $surface;
}

#settings-body {
    height: auto;
    scrollbar-size-vertical: 1;
}

/* Each section's title sits in a line across the dialog, in the accent
   colour, so sections don't blend into their options. */
.settings-section {
    height: auto;
    margin-top: 1;
    border-top: solid $primary 50%;
    border-title-align: left;
    border-title-color: $text-accent;
    border-title-style: bold;
}

.settings-row {
    height: 1;
    margin-top: 1;
}

.settings-label {
    width: 20;
}

.settings-row Select {
    width: 22;
    margin-right: 2;
}

.settings-sample {
    width: 1fr;
}

.settings-section > .settings-row:first-child {
    margin-top: 0;
}

.settings-note {
    color: $text-muted;
}

#settings-buttons {
    height: 1;
    margin: 1 0 1 0;
}

#settings-buttons Button {
    width: auto;
    min-width: 10;
}

.settings-spacer {
    width: 1fr;
}

#settings Checkbox {
    border: none;
    padding: 0;
    background: transparent;
}

/* ---- Fields stand out from what they sit on -------------------------------
   Textual paints inputs, dropdowns, text areas and check boxes $surface - the
   colour of every dialog panel here, and close to the main screen's panels -
   so they read as plain text (contrast 1.0-1.3:1 measured). Instead tint each
   field toward the text colour over whatever is behind it: lighter in dark
   themes, darker in light ones, the same step on any panel. (A white well
   did nothing for light themes, whose panels are near white already.) */
Input, TextArea, SelectCurrent, SelectOverlay {
    background: $foreground 20%;
    &:ansi {
        background: ansi_default;
    }
}

ToggleButton > .toggle--button {
    background: $foreground 20%;
}
