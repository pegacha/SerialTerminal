# Python bytecode / caches
__pycache__/
*.py[cod]

# Build & packaging artifacts
build/
dist/
*.egg-info/

# Runtime logs
serialterminal.log*

# Local machine state (ports, theme, last-opened path) - not shareable
settings.yml

# No YAML is shipped: project.yml holds device-specific commands and is
# rewritten by the app, settings.yml is per-machine; both are created on first
# launch. Ctrl+E exports a config when you want to share one. Only GitHub's
# workflow definitions, which must be YAML, are kept.
*.yml
*.yaml
!.github/workflows/*.yml

# Claude Code project files (skills, local settings) stay on this machine.
.claude/
